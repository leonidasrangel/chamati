# Copie para .env e ajuste. Na Vercel, cadastre as mesmas variáveis em
# Project → Settings → Environment Variables (DATABASE_URL vem da integração Neon).

# Conexão com o PostgreSQL (com pooler, usada pelo app)
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/chamati?schema=public"
# Conexão direta, usada pelas migrações (opcional localmente; a Neon preenche sozinha)
# DATABASE_URL_UNPOOLED=""

# Segredo da sessão. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Administrador criado pelo seed quando o banco ainda não tem nenhum (npm run db:seed)
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_NAME="Nome do Administrador"
ADMIN_PASSWORD=""
