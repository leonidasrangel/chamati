# Copie para .env e ajuste. Em produção (Render), as mesmas variáveis são
# pedidas pelo blueprint render.yaml.

# Conexão com o PostgreSQL usada pelo app (na Neon: com pooler, host "-pooler")
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/chamati?schema=public"
# Conexão direta, usada pelas migrações (opcional localmente; na Neon: sem pooler)
# DATABASE_URL_UNPOOLED=""

# Segredo da sessão. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Administrador criado pelo seed quando o banco ainda não tem nenhum (npm run db:seed)
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_NAME="Nome do Administrador"
ADMIN_PASSWORD=""
